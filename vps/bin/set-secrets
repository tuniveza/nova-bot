#!/usr/bin/env bash
# Desk: type in the secret keys Nova Bot needs that couldn't be copied (Cloudflare never gives
# them back). Each one is asked for with hidden typing; press Enter to keep what's there (or to
# skip one you don't use). They're kept in /srv/nova/secrets.env, readable only by Nova Bot.
# Run on the VPS:  sudo /srv/nova/bin/set-secrets
set -euo pipefail
FILE=/srv/nova/secrets.env
umask 077
touch "$FILE"
NAMES=(
  "RESEND_API_KEY|Resend key for single emails (replies, one-to-one emails, invoices)"
  "RESEND_MARKETING_KEY|Resend full-access key for campaigns"
  "CAMPAIGN_FROM|The address campaigns come from"
  "ENQUIRY_EMAIL_FROM|The address enquiry emails come from"
  "ENQUIRY_EMAIL_TO|Where new enquiries are emailed (comma-separated)"
  "VAPID_PUBLIC_KEY|Phone notifications: public key (the SAME as on Cloudflare, or phones must sign up again)"
  "VAPID_PRIVATE_KEY|Phone notifications: private key (the SAME as on Cloudflare)"
  "ACUITY_USER_ID|Acuity user id"
  "ACUITY_API_KEY|Acuity API key"
  "ACUITY_CALENDAR_URL|Acuity calendar feed address"
  "ACUITY_WEBHOOK_KEY|Acuity webhook key"
  "ACUITY_EMAIL_KEY|Acuity email key"
  "ANTHROPIC_API_KEY|Claude key (already copied from the studio PC; Enter keeps it)"
  "STRIPE_SECRET_KEY|Stripe secret key (optional)"
  "STRIPE_WEBHOOK_SECRET|Stripe webhook secret (optional)"
  "META_PAGE_TOKEN|Meta page token (optional, for Social)"
  "META_PAGE_ID|Meta page id (optional)"
  "META_IG_USER_ID|Instagram user id (optional)"
  "TURN_KEY_ID|Lossless audio TURN key id (optional)"
  "TURN_KEY_API_TOKEN|Lossless audio TURN token (optional)"
)
have() { grep -q "^$1=" "$FILE"; }
for row in "${NAMES[@]}"; do
  name=${row%%|*}; what=${row#*|}
  mark=$(have "$name" && echo " [set]" || echo "")
  read -r -s -p "$name — $what$mark: " value; echo
  [ -z "$value" ] && continue
  grep -v "^$name=" "$FILE" > "$FILE.new" || true
  printf '%s=%s\n' "$name" "$value" >> "$FILE.new"
  mv "$FILE.new" "$FILE"
done
chown nova:nova "$FILE"; chmod 600 "$FILE"
ln -sf "$FILE" /srv/nova/app/.dev.vars
echo "Saved. Restarting Nova Bot…"
systemctl restart nova
