# Computer's web address (vps/README.md). To use your own domain later, change the address on the
# next line (and in /srv/nova/desk.env), then: systemctl reload caddy && systemctl restart nova
{$DESK_HOSTNAME} {
	encode zstd gzip
	# The runtime's own test door for the timed jobs: only from the VPS itself, never from outside
	@inside path /__scheduled* /cdn-cgi/*
	handle @inside {
		respond 404
	}
	# The VPS's desktop (Computer panel; vps/desktop-setup.sh): signed-in admins only, asked of Nova Bot first.
	# (Here too, not only added by desktop-setup.sh: vps/deploy.sh writes this file afresh on every deploy)
	@desk path /vps-desktop /vps-desktop/*
	handle @desk {
		forward_auth 127.0.0.1:8787 {
			uri /app/api/admin-check
			# A plain question, not a page: without these Nova Bot would send a browser's page request on to Nova Agent
			header_up -Sec-Fetch-Dest
			header_up -Sec-Fetch-Mode
			header_up Accept application/json
		}
		handle /vps-desktop/websockify {
			reverse_proxy 127.0.0.1:6081
		}
		handle_path /vps-desktop/* {
			root * /usr/share/novnc
			file_server
		}
	}
	# Computer's status service (token only: vps/desk-status/server.mjs)
	handle /desk-status/* {
		reverse_proxy 127.0.0.1:8788
	}
	# Files (17 Oct 2026): the panels' scripts, styles, pictures and sounds straight from disk, never
	# through the runtime: wrangler dev kept memory for every file it handed out, three requests in four
	# were these, and Nova Bot was restarted every 25 minutes to 2 hours for it. Only files that exist (a
	# copy of public/ Caddy may read, made by vps/deploy.sh), never a page, a service worker or the
	# manifest (their headers come from public/_headers), and never what the Worker answers first
	# (wrangler.jsonc's run_worker_first). Anything else goes on to Nova Bot as before.
	@file {
		path_regexp \.(js|mjs|css|svg|png|jpe?g|webp|gif|ico|woff2?|ttf|otf|mp3|wav|ogg|m4a|webm|mp4|json|txt|map)$
		not path */sw.js */manifest.webmanifest /observatory/data/* /observatory/media/* /agent/apps/* /agent/plans/* /agent/tools/* /agent/helpers/*
		file {
			root /srv/nova-files
		}
	}
	handle @file {
		root * /srv/nova-files
		# (as Nova Bot answered them: always asked again, a quick 304 when nothing changed)
		header Cache-Control "public, max-age=0, must-revalidate"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8787 {
			# Who's asking (the Worker reads it as Cloudflare's header for its rate limits)
			header_up CF-Connecting-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			# The runtime's own proxy (wrangler dev) answers on plain http, so the redirects it sends
			# say http://<this address>/…; people only ever use https here, so say that (one hop less)
			header_down Location "^http://((nova\.novacane\.co\.uk|[0-9-]+\.sslip\.io)(/|$))" "https://$1"
		}
	}
	log {
		output file /var/log/caddy/desk.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
