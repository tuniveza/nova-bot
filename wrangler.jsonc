/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "novacane-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-09-26",
	// Fetches go out over the public internet, so the Links page can check the
	// other Nova apps on this account (workers.dev) as anyone else would see them
	"compatibility_flags": ["global_fetch_strictly_public"],
	"observability": {
			"logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"invocation_logs": true,
		"persist": true
		},
		"traces": {
		"enabled": false,
		"head_sampling_rate": 1,
		"persist": true
		}
	},
	"upload_source_maps": true,
	// Workers AI: NovaBot's voice (speech) and ears (Whisper)
	"ai": { "binding": "AI" },
	// The chat widget files (novabot.js, novabot.css) the website loads
	"assets": { "directory": "./public" },
	// Referral tracking: appointments and referral codes.
	// Create it once with `npx wrangler d1 create novabot` and paste the
	// database_id it prints here (see README-REFERRALS.md).
	// Limits per visitor (by IP address), so nobody can run up the bill:
	// chat messages and voice requests per minute, and Nova Club calendar checks
	"ratelimits": [
		{ "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
		{ "name": "VOICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
		{ "name": "CLUB_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
	],
	// Every minute: send booking notifications that waited long enough for Acuity's email (booking-pings.js)
	"triggers": { "crons": ["* * * * *"] },
	// A sandbox for testing on your own computer: npm run sandbox (see README.md).
	// Local database only, no Workers AI (voice uses the browser's own voice),
	// and SANDBOX turns on the demo page and stand-in replies.
	"env": {
		"sandbox": {
			"name": "novabot-sandbox",
			"vars": { "SANDBOX": "true", "PUBLIC_URL": "http://localhost:8787" },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "novabot-sandbox",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"ratelimits": [
				{ "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
				{ "name": "VOICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
				{ "name": "CLUB_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
			]
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "novabot",
			"database_id": "56d36897-7a90-4f70-8b2b-47f56bd6c84f",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
	// ...

}
